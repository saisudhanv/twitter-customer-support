# LLM API Configuration
# Supports: openai, anthropic, or local via ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# Alternative LLM providers (uncomment to use)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# CLAUDE_MODEL=claude-3-opus-20240229
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# Kaggle API (for dataset download)
# Create ~/.kaggle/kaggle.json with your credentials for automatic download
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# Data Configuration
DATA_SAMPLE_SIZE=500  # Use smaller sample for quick runs
RANDOM_SEED=42

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3

# Evaluation
EVAL_SAMPLE_SIZE=200
LLM_JUDGE_CACHE_DIR=artifacts/cached_outputs/llm_judge

# Development
DEBUG=false
VERBOSE=true
